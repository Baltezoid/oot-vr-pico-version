+# SOH [Pico] The PICO runtime needs the PICO loader (PICO OpenXR SDK, libs/android.arm64-v8a). Put
+# it in port/Android/pico/, or set PICO_OPENXR_LOADER. The Khronos loader from the AAR stays for the
+# headers and for the link. Only the file in the APK changes: both have the name libopenxr_loader.so.
+PICO_LOADER="${PICO_OPENXR_LOADER:-$ANDROID_DIR/pico/libopenxr_loader.so}"
+if [ -f "$PICO_LOADER" ]; then
+    echo "==> OpenXR loader: PICO ($PICO_LOADER)"
+    OPENXR_SO="$PICO_LOADER"
+fi
+"$STRIP" --strip-unneeded -o "$LIBS/libopenxr_loader.so" "$OPENXR_SO"
 
