+// SOH [Pico] XR_BD_controller_interaction: the extension that adds the PICO controller profiles to
+// the OpenXR registry. The PICO runtime lists it when it supports the profiles. The header of the
+// PICO SDK 2.1.0 does not define the name, thus the string is here.
+static const char kXrBdControllerInteraction[] = "XR_BD_controller_interaction";
+static bool g_bd_controller_supported = false;
+
+// SOH [Pico] Writes the interaction profile that the runtime selected for each hand. If the
+// controllers do not work on the headset, this line in `adb logcat -s soh:V` tells which profile
+// the runtime used.
+static void vr_log_interaction_profiles() {
+    for (int h = 0; h < 2; h++) {
+        XrInteractionProfileState state = { XR_TYPE_INTERACTION_PROFILE_STATE };
+        if (!XR_SUCCEEDED(xrGetCurrentInteractionProfile(xr.session, xr.hand_path[h], &state))) {
+            continue;
+        }
+        char text[XR_MAX_PATH_LENGTH] = "(none)";
+        uint32_t len = 0;
+        if (state.interactionProfile != XR_NULL_PATH) {
+            xrPathToString(xr.instance, state.interactionProfile, XR_MAX_PATH_LENGTH, &len, text);
+        }
+        spdlog::info("[VR] Interaction profile, {} hand: {}", h == 0 ? "left" : "right", text);
+    }
+}
+
 static void poll_events() {
